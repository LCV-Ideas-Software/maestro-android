<?xml version="1.0" encoding="utf-8"?>
<!--
  As permissões do produto, cada uma com o seu motivo (especificação):
  INTERNET — os seis provedores e a auditoria de links (o `:core:provedores` é
  Kotlin puro e não declara nada); POST_NOTIFICATIONS — pedida na tela, antes
  da primeira sessão, com a razão dita em texto (seção 4.1); USE_BIOMETRIC —
  o `BiometricPrompt` da plataforma que renova a janela de autenticação da
  chave do Keystore (seção 6.2). FOREGROUND_SERVICE e o tipo `dataSync` vêm do
  manifesto do `:core:sessao`, pela fusão.

  O aplicativo não entra no backup na nuvem (`allowBackup="false"`, seção
  4.2): nada do que ele grava é preferência a restaurar. No Android 12 ou
  superior o atributo não desliga a transferência entre aparelhos, e por isso
  o banco do Room fica fora dela pelas `dataExtractionRules`; o segredo
  cifrado vive em `noBackupFilesDir`, que o Android exclui sempre.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- "Abrir no navegador", na revisão de links (seção 2.2; plano do `:app`,
         emenda A10): os navegadores ficam visíveis ao aplicativo no Android 11
         e depois. O disparo em si é `startActivity`, que não depende desta
         declaração; sem navegador, ele lança `ActivityNotFoundException`. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MaestroApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Maestro">

        <!-- Uma Activity só, `singleTask`: o toque na notificação da sessão
             chega por `onNewIntent` quando o aplicativo já está aberto, e por
             `onCreate` quando não está; nos dois casos a tela da sessão abre. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Maestro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Inicialização sob demanda do WorkManager: só o inicializador
             automático dele sai do provedor do App Startup (o provedor fica,
             para o que mais o usar); a configuração vem de
             `MaestroApplication`, que é `Configuration.Provider` e instala a
             `FabricaDeTrabalhos` do `:core:sessao`. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
