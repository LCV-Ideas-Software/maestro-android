<?xml version="1.0" encoding="utf-8"?>
<!--
  Especificação, seção 4.2: o cifrado das chaves de API fica fora do backup na
  nuvem e da transferência entre aparelhos. Sem a chave do Keystore, que não
  sai do aparelho, ele não abre em outro lugar; e o que está aqui é conteúdo do
  usuário que a seção 6 promete manter só neste aparelho.

  O caminho é o do DataStore do `:core:seguranca`:
  `files/datastore/<CofreDeChaves.ARQUIVO>.preferences_pb`.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/maestro_chaves.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/maestro_chaves.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
