<?xml version="1.0" encoding="utf-8"?>
<!--
  O banco do Room (`maestro.db`, com o texto das sessões, e os arquivos
  `-wal`, `-shm` e `-journal` do SQLite) fica fora do backup na nuvem e da
  transferência entre aparelhos, nos dois domínios que a regra separa
  (especificação, seção 4.2). O segredo cifrado e os corpos de evidência e
  anexos vivem em `noBackupFilesDir`, que o Android exclui sempre, sem regra.
  A exclusão é do conteúdo do usuário, não do aplicativo: preferência de
  interface continua restaurável.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="maestro.db" />
        <exclude domain="database" path="maestro.db-wal" />
        <exclude domain="database" path="maestro.db-shm" />
        <exclude domain="database" path="maestro.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="maestro.db" />
        <exclude domain="database" path="maestro.db-wal" />
        <exclude domain="database" path="maestro.db-shm" />
        <exclude domain="database" path="maestro.db-journal" />
    </device-transfer>
</data-extraction-rules>
